      "thumbnail": "https://simkl.in/episodes/17/17545901f7f35a0e08_w.webp",
      "imageUrl": "https://simkl.in/episodes/17/17545901f7f35a0e08_w.webp",
      "description": "Mob is in a great mood because he got to talk to Tsubomi for the first time in a while. As he`s walking through town, he feels the stares of other girls..."
    },
    {
      "episode": 4,
      "episodeNumber": 4,
      "title": "Divine Tree 1: The Founder Appears",
      "aired": "2022-10-27T00:00:00+09:00",
      "airedDate": "2022-10-27T00:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/17/17545903582d7b99bc_w.webp",

      "thumbnail": "https://simkl.in/episodes/17/17545905e8d2253ab4_w.webp",
      "imageUrl": "https://simkl.in/episodes/17/17545905e8d2253ab4_w.webp",
      "description": "Mob heads into the Divine Tree, only to have to face off with Teru. Mob finds himself speechless, having to confront even Teru who has been completely brainwashed by Psycho Helmet."
    },
    {
      "episode": 6,
      "episodeNumber": 6,
      "title": "Divine Tree 3: Dimple Is",
      "aired": "2022-11-10T00:00:00+09:00",
      "airedDate": "2022-11-10T00:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/17/1754590772b8d2a35a_w.webp",
      "imageUrl": "https://simkl.in/episodes/17/1754590772b8d2a35a_w.webp",
      "description": "Mob`s attitude seems to change once he hears what Dimple says. Mob ends up apologizing to Dimple because he had gotten carried away from the thought of being popular and didn`t hear what Dimple had to tell him before."
    },
    {
      "episode": 7,
      "episodeNumber": 7,
      "title": "Transmission 1: Winter Break",

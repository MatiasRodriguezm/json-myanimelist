  "episodes_data": [
    {
      "episode": 1,
      "episodeNumber": 1,
      "title": "Thanatos. (Overlooking View)",
      "aired": "2007-12-01T00:15:00+09:00",
      "airedDate": "2007-12-01T00:15:00+09:00",
      "thumbnail": "https://simkl.in/episodes/65/6539787bd737887e7_w.webp",
      "imageUrl": "https://simkl.in/episodes/65/6539787bd737887e7_w.webp",
      "description": "In September 1998, a string of seemingly random suicides leaves Japan baffled and devastated. But a detective agency specializing in paranormal occurrences notices that there are a few glaring, disturbing similarities tying the deceptively unrelated cases together: All the victims are schoolgirls, and all of them have jumped to their deaths from atop the condemned Fujou Building..."
    },
    {
      "episode": 2,
      "episodeNumber": 2,
      "title": "...And Nothing Heart. (Murder Speculation Part A)",
      "aired": "2007-12-29T00:15:00+09:00",
      "airedDate": "2007-12-29T00:15:00+09:00",
      "thumbnail": "https://simkl.in/episodes/65/6539785d310271109_w.webp",
      "imageUrl": "https://simkl.in/episodes/65/6539785d310271109_w.webp",
      "description": "In the winter of 1995, Mikiya Kokutou passes a young woman during a late night stroll in the snow. Clad in a striking white kimono and bearing an enigmatic gaze, Shiki Ryougi smiles at Mikiya who stares back with curiosity. As they become acquaintances through lunchtime conversations, Shiki begins opening up to him, with Mikiya learning about her unique upbringing."
    },
    {
      "episode": 3,
      "episodeNumber": 3,
      "title": "Ever Cry, Never Life. (Remaining Sense of Pain)",
      "aired": "2008-02-09T00:15:00+09:00",
      "airedDate": "2008-02-09T00:15:00+09:00",
      "thumbnail": "https://simkl.in/episodes/65/653978322d87b6fe0_w.webp",
      "imageUrl": "https://simkl.in/episodes/65/653978322d87b6fe0_w.webp",
      "description": "On a solemn night in July 1998, teenager Fujino Asagami is mercilessly raped by a street gang in a dilapidated bar. No matter what physical or sexual abuse they deal, however, the girl regards her captors with the same apathetic expression. The next day, mangled bodies are discovered in that same building, so torn apart that investigators find it infeasible to even consider the culprit human..."
    },
    {
      "episode": 4,
      "episodeNumber": 4,
      "title": "Garan-no-Dou. (The Hollow Shrine)",
      "aired": "2008-05-24T00:15:00+09:00",
      "airedDate": "2008-05-24T00:15:00+09:00",
      "thumbnail": "https://simkl.in/episodes/65/653978141b16452ca_w.webp",
      "imageUrl": "https://simkl.in/episodes/65/653978141b16452ca_w.webp",
      "description": "June 1998: After spending two years in a coma caused by a traffic accident, Shiki Ryougi awakens with amnesia. She is visited by Touko Aozaki, a wizard and proprietor of a studio called Garan no Dou. Shiki has lost not only the memory of her accident, but also any real sense that she`s even alive. Strangely, enigmatic beings begin to attack her..."
    },
    {
      "episode": 5,
      "episodeNumber": 5,
      "title": "Paradox Paradigm.",
      "aired": "2008-08-16T00:15:00+09:00",
      "airedDate": "2008-08-16T00:15:00+09:00",
      "thumbnail": "https://simkl.in/episodes/65/65397792cc53c2a07_w.webp",
      "imageUrl": "https://simkl.in/episodes/65/65397792cc53c2a07_w.webp",
      "description": "In November 1998, a double homicide occurs at the newly constructed Ogawa apartment complex. Shiki meets a boy named Tomoe Enjou, a runaway who claims to be the murderer, and lets him use her apartment as his hideout. From that day onward, their strange cohabitation begins. Coincidentally, Mikiya Kokutou is investigating a tip regarding the murder at that unique apartment complex..."
    },
    {
      "episode": 6,
      "episodeNumber": 6,
      "title": "Fairy Tale. (Oblivion Recording)",
      "aired": "2008-12-20T00:15:00+09:00",
      "airedDate": "2008-12-20T00:15:00+09:00",
      "thumbnail": "https://simkl.in/episodes/65/6539777f29f74fb87_w.webp",
      "imageUrl": "https://simkl.in/episodes/65/6539777f29f74fb87_w.webp",
      "description": "January 1999: Apprentice mage Azaka Kokutou, Mikiya`s younger sister, has been ordered by her mentor, Touko Aozaki, to investigate a certain incident in which fairies steal the memories of students at Azaka`s school, Reien Academy. Azaka launches an investigation with the help of Shiki."
    },
    {
      "episode": 7,
      "episodeNumber": 7,
      "title": "......Not Nothing Heart. (Murder Speculation Part B)",
      "aired": "2009-08-08T00:15:00+09:00",
      "airedDate": "2009-08-08T00:15:00+09:00",
      "thumbnail": "https://simkl.in/episodes/65/65397750677a7939b_w.webp",
      "imageUrl": "https://simkl.in/episodes/65/65397750677a7939b_w.webp",
      "description": "In February 1999, a string of murders has Shiki Ryougi and Mikiya Kokutou on edge. These crimes share a disturbing resemblance to a similar set of homicides from 1995, when Shiki and Mikiya first met, and awaken a dark, murderous desire that has laid dormant within Shiki`s soul ever since then."
    }

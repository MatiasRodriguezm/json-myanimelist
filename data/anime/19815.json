  "episodes_data": [
    {
      "episode": 1,
      "episodeNumber": 1,
      "title": "Beginner",
      "aired": "2014-04-09T21:30:00+09:00",
      "airedDate": "2014-04-09T21:30:00+09:00",
      "thumbnail": "https://simkl.in/episodes/26/2649612b07e4da138_w.webp",
      "imageUrl": "https://simkl.in/episodes/26/2649612b07e4da138_w.webp",
      "description": "Sora and Shiro are unemployed and never leave their house, but on the net, they`re known as \"Blank\", an invincible team of gamers.  One day, these siblings are visited by a boy named Tet, who calls himself god.  Tet summons them to a world where all war is banned, and everything is decided by games."
    },
    {
      "episode": 2,
      "episodeNumber": 2,
      "title": "Challenger",
      "aired": "2014-04-16T21:30:00+09:00",
      "airedDate": "2014-04-16T21:30:00+09:00",
      "thumbnail": "https://simkl.in/episodes/26/2651322796d8f18a5_w.webp",
      "imageUrl": "https://simkl.in/episodes/26/2651322796d8f18a5_w.webp",
      "description": "Sora and Shiro have been abandoned in another world by Tet.  In this world all war is forbidden, and everything is determined by games whose rules are determined by the \"Ten Pledges\" that Tet established.\nThey find themselves in the country of humanity, the weakest of the 16 races in this new world."
    },
    {
      "episode": 3,
      "episodeNumber": 3,
      "title": "Expert",
      "aired": "2014-04-23T21:30:00+09:00",
      "airedDate": "2014-04-23T21:30:00+09:00",
      "thumbnail": "https://simkl.in/episodes/26/265068879990687be_w.webp",
      "imageUrl": "https://simkl.in/episodes/26/265068879990687be_w.webp",
      "description": "A girl named Clamy has won the right to be the next king of Elukia by her overwhelming good luck.  Steph lost to her and loses the chance to become the next ruler.  Just as she defeats the last challenger, however, Sora and Shiro interrupt her."
    },
    {
      "episode": 4,
      "episodeNumber": 4,
      "title": "Grandmaster",
      "aired": "2014-04-30T21:30:00+09:00",
      "airedDate": "2014-04-30T21:30:00+09:00",
      "thumbnail": "https://simkl.in/episodes/26/26521004498683997_w.webp",
      "imageUrl": "https://simkl.in/episodes/26/26521004498683997_w.webp",
      "description": "The game Clamy challenged them to wasn`t normal chess.  Shiro is a chess master, but even she is helpless against Clami`s assault.  But when Shiro understands the real rules of the game, things begind to turn around.  The battle to determine the king of Elukia, and all of humanity, finally reaches its end."
    },
    {
      "episode": 5,
      "episodeNumber": 5,
      "title": "Weak Square",
      "aired": "2014-05-07T21:30:00+09:00",
      "airedDate": "2014-05-07T21:30:00+09:00",
      "thumbnail": "https://simkl.in/episodes/26/2651750ac721e6aad_w.webp",
      "imageUrl": "https://simkl.in/episodes/26/2651750ac721e6aad_w.webp",
      "description": "Sora and Shiro leave the running of the country to Steph and spend every day playing video games.  Steph`s hope that they would become not only the saviors of Elukia, but all of humanity, crumbles away."
    },
    {
      "episode": 6,
      "episodeNumber": 6,
      "title": "Interesting",
      "aired": "2014-05-14T21:30:00+09:00",
      "airedDate": "2014-05-14T21:30:00+09:00",
      "thumbnail": "https://simkl.in/episodes/26/265292086158d0571_w.webp",
      "imageUrl": "https://simkl.in/episodes/26/265292086158d0571_w.webp",
      "description": "Sora goes to regain the national library, which was lost in a game with the 6th ranked race, the Flugel.  There he meets a Flugel who calls herself Jibril."
    },
    {
      "episode": 7,
      "episodeNumber": 7,
      "title": "Sacrifice",
      "aired": "2014-05-21T21:30:00+09:00",
      "airedDate": "2014-05-21T21:30:00+09:00",
      "thumbnail": "https://simkl.in/episodes/26/2652256e0a59d3008_w.webp",
      "imageUrl": "https://simkl.in/episodes/26/2652256e0a59d3008_w.webp",
      "description": "Sora and Shiro have their eyes on the 3rd largest country in the world, the Eastern Federation.  But Jibril tells them that they`ll never be able to win, because even the largest country, the Elven Garde, and Jibril herself, can`t beat them."
    },
    {
      "episode": 8,
      "episodeNumber": 8,
      "title": "Fake End",
      "aired": "2014-05-28T21:30:00+09:00",
      "airedDate": "2014-05-28T21:30:00+09:00",
      "thumbnail": "https://simkl.in/episodes/26/26539268f9af4e0f8_w.webp",
      "imageUrl": "https://simkl.in/episodes/26/26539268f9af4e0f8_w.webp",
      "description": "Sora and Shiro have found the secret reason why the Eastern Federation never loses at a game, and visit their embassy.  They declare war on the Eastern Federation and demand all the territory on the continent.  \nThe Federation tries its hardest to avoid the game, but Sora reveals their secrets and makes them an offer they can`t refuse."
    },
    {
      "episode": 9,
      "episodeNumber": 9,
      "title": "Sky Walk",
      "aired": "2014-06-04T21:30:00+09:00",
      "airedDate": "2014-06-04T21:30:00+09:00",
      "thumbnail": "https://simkl.in/episodes/26/265344220fe79f87f_w.webp",
      "imageUrl": "https://simkl.in/episodes/26/265344220fe79f87f_w.webp",
      "description": "When Shiro wakes up, Sora is gone.  It`s as if he never existed, and he`s vanished from Shiro`s smartphone and Steph and Jibril`s memories.  She knows he`s real, but everything around her says otherwise.  Jibril begins to suspect that she lost a game and has had false memories implanted."
    },
    {
      "episode": 10,
      "episodeNumber": 10,
      "title": "Blue Rose",
      "aired": "2014-06-11T21:30:00+09:00",
      "airedDate": "2014-06-11T21:30:00+09:00",
      "thumbnail": "https://simkl.in/episodes/26/26547568e1206008a_w.webp",
      "imageUrl": "https://simkl.in/episodes/26/26547568e1206008a_w.webp",
      "description": "Sora manages to win his game against Clami and Fi, and asks for their help in fighting the Eastern Federation.  Clami understands what he`s after and accepts his request, and promises to fight the Eastern Federation with him. Now that they`re allies, Sora invites them to partake of a Japanese tradition, the bath..."
    },
    {
      "episode": 11,
      "episodeNumber": 11,
      "title": "Killing Giant",
      "aired": "2014-06-18T21:30:00+09:00",
      "airedDate": "2014-06-18T21:30:00+09:00",
      "thumbnail": "https://simkl.in/episodes/26/2654578b4fabc5025_w.webp",
      "imageUrl": "https://simkl.in/episodes/26/2654578b4fabc5025_w.webp",
      "description": "At last, the game with the Eastern Federation begins.  It`s a first person shooter held in virtual space.  Through a variety of strategies, they manage to match the overwhelmingly powerful Izuna.  However, their perfect attack is easily dodged, and suddenly they`re in huge danager.  As things get worse, Shiro takes a hit meant for Sora."
    },
    {
      "episode": 12,
      "episodeNumber": 12,
      "title": "Rule Number 10",
      "aired": "2014-06-25T21:30:00+09:00",
      "airedDate": "2014-06-25T21:30:00+09:00",
      "thumbnail": "https://simkl.in/episodes/26/265422218ce598c2f_w.webp",
      "imageUrl": "https://simkl.in/episodes/26/265422218ce598c2f_w.webp",
      "description": "Izuna uses her Blood Destruction ability, which lets her temporarily gain abilities beyond the laws of physics.  All Sora and Shiro can do is run.  Her astonishing physical abilities allow her to dodge attacks that should be undodgable.  At last, her gun is pointed at Sora and Shiro."
    }
  ],

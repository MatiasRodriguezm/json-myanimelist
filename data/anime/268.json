    {
      "episode": 1,
      "episodeNumber": 1,
      "title": "Computer Studies",
      "aired": "1995-10-27T19:00:00+09:00",
      "airedDate": "1995-10-27T19:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/15/150908b0bb8b2ca4_w.webp",
      "imageUrl": "https://simkl.in/episodes/15/150908b0bb8b2ca4_w.webp",
      "description": "Kintaro obtains a janitorial job at an all-woman software firm led by the Ferrari-driving, skimpily clad Madame President. An electrical accident jeopardizes the firm`s future allowing Kintaro to put his newly acquired programming skills to the test."
    },
    {
      "episode": 2,
      "episodeNumber": 2,
      "title": "The Temptation of the Maiden",
      "aired": "1995-11-22T19:00:00+09:00",
      "airedDate": "1995-11-22T19:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/15/150910c834e7fde6_w.webp",
      "imageUrl": "https://simkl.in/episodes/15/150910c834e7fde6_w.webp",
      "description": "Working as a campaign staffer for a mayoral candidate, Kintaro is assigned to tutor his boss` attractive teenaged daughter, Naoko Katsuda, who wants more from him than help with her math homework."
    },
    {
      "episode": 3,
      "episodeNumber": 3,
      "title": "Danger! The Virgin's First Love",
      "aired": "1995-12-22T19:00:00+09:00",
      "airedDate": "1995-12-22T19:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/15/150912a45042141a_w.webp",
      "imageUrl": "https://simkl.in/episodes/15/150912a45042141a_w.webp",
      "description": "A car accident has left the owner of a udon restaurant temporarily handicapped, and Kintaro is helping out and learning the trade. The owner`s daughter, Noriko has a well-heeled suitor, but a series of events leads Kintaro to doubt his sincerity."
    },
    {
      "episode": 4,
      "episodeNumber": 4,
      "title": "Swimming in the Sea of Love",
      "aired": "1996-04-26T19:00:00+09:00",
      "airedDate": "1996-04-26T19:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/15/150914e694fe851f_w.webp",
      "imageUrl": "https://simkl.in/episodes/15/150914e694fe851f_w.webp",
      "description": "Kintaro has challenged the local swimming coach (and former Olympic athlete) to a race, but he first needs to learn how to swim. While training, however, his situation with the coach, Ayuko Haramizu is compromised."
    },
    {
      "episode": 5,
      "episodeNumber": 5,
      "title": "Unstoppable Youth",
      "aired": "1996-05-24T19:00:00+09:00",
      "airedDate": "1996-05-24T19:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/15/150916c09d900511_w.webp",
      "imageUrl": "https://simkl.in/episodes/15/150916c09d900511_w.webp",
      "description": "Kintaro becomes a servant in a traditional-style mansion of a wealthy family, but is quickly dismissed. He then challenges the daughter Tarayama Reiko, who abhors men and has a fetish for her motorcycle to a race."
    },
    {
      "episode": 6,
      "episodeNumber": 6,
      "title": "Animation Is Fun!",
      "aired": "1996-06-28T19:00:00+09:00",
      "airedDate": "1996-06-28T19:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/15/15091884c88a6bd1_w.webp",

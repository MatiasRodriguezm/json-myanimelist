  "episodes_data": [
    {
      "episode": 1,
      "episodeNumber": 1,
      "title": "Maomao",
      "aired": "2023-10-22T23:00:00+09:00",
      "airedDate": "2023-10-22T23:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/14/1468765039bb184d77_w.webp",
      "imageUrl": "https://simkl.in/episodes/14/1468765039bb184d77_w.webp",
      "description": "After being kidnapped and forced to work as a servant in the rear palace, former apothecary Maomao inadvertently draws the attention of the higher ranks when she investigates what`s causing the emperor`s infant heirs to fall mysteriously ill."
    },
    {
      "episode": 2,
      "episodeNumber": 2,
      "title": "Chilly Apothecary",
      "aired": "2023-10-22T23:00:00+09:00",
      "airedDate": "2023-10-22T23:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/14/14687648d0a6a3532d_w.webp",
      "imageUrl": "https://simkl.in/episodes/14/14687648d0a6a3532d_w.webp",
      "description": "Maomao tries to settle into her promotion to lady-in-waiting and food taster, but struggles to fend off both boredom and the overly-familiar Jinshi. That is, until she gets an assignment of her dreams: to concoct an aphrodisiac."
    },
    {
      "episode": 3,
      "episodeNumber": 3,
      "title": "The Unsettling Matter of the Spirit",
      "aired": "2023-10-22T23:00:00+09:00",
      "airedDate": "2023-10-22T23:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/14/14687646affc5320f2_w.webp",
      "imageUrl": "https://simkl.in/episodes/14/14687646affc5320f2_w.webp",
      "description": "Tasked with investigating a ghostly woman dancing nightly on the palace walls, Maomao finds a sleepwalking Concubine Fuyou. But with no medicinal cure for sleepwalking, she`s forced to dig deeper to find the real reason behind Fuyou`s affliction."
    },
    {
      "episode": 4,
      "episodeNumber": 4,
      "title": "The Threat",
      "aired": "2023-10-29T23:00:00+09:00",
      "airedDate": "2023-10-29T23:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/14/14705050cdf385436e_w.webp",
      "imageUrl": "https://simkl.in/episodes/14/14705050cdf385436e_w.webp",
      "description": "Under direct orders from the emperor himself, Maomao tries to care for an ailing Concubine Lihua, but finds her work impeded by Lihua`s own ladies-in-waiting."
    },
    {
      "episode": 5,
      "episodeNumber": 5,
      "title": "Covert Operations",
      "aired": "2023-11-05T23:00:00+09:00",
      "airedDate": "2023-11-05T23:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/14/1473379694ba1f9967_w.webp",
      "imageUrl": "https://simkl.in/episodes/14/1473379694ba1f9967_w.webp",
      "description": "A eunuch stricken by a curse comes begging for aid. Meanwhile, the rear palace buzzes with excitement as everyone prepares for the upcoming garden party, and Gyokuyou`s ladies-in-waiting aren`t about to let Maomao get away without dressing her up."
    },
    {
      "episode": 6,
      "episodeNumber": 6,
      "title": "The Garden Party",
      "aired": "2023-11-12T23:00:00+09:00",
      "airedDate": "2023-11-12T23:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/14/14799266f8912959d9_w.webp",
      "imageUrl": "https://simkl.in/episodes/14/14799266f8912959d9_w.webp",
      "description": "Maomao does her best to navigate the complex social situations at the garden party, including meeting the other Upper First rank concubines. But once she settles down to do her work as a food-taster, she discovers a surprise in a bowl of soup."
    },
    {
      "episode": 7,
      "episodeNumber": 7,
      "title": "Homecoming",
      "aired": "2023-11-19T23:00:00+09:00",
      "airedDate": "2023-11-19T23:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/14/1489704638895e08c4_w.webp",
      "imageUrl": "https://simkl.in/episodes/14/1489704638895e08c4_w.webp",
      "description": "Gaoshun goes to Maomao to get her help in resolving the events of the garden party. Later, Xiaolan explains the purpose of the hairpins Maomao was gifted, and Maomao makes a deal with Lihaku in order to finally visit home."
    },
    {
      "episode": 8,
      "episodeNumber": 8,
      "title": "Wheat Stalks",
      "aired": "2023-11-26T23:00:00+09:00",
      "airedDate": "2023-11-26T23:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/14/1492933428528c5b50_w.webp",
      "imageUrl": "https://simkl.in/episodes/14/1492933428528c5b50_w.webp",
      "description": "Maomao`s peaceful morning at home is interrupted when she`s called in to investigate an apparent double suicide at one of the local brothels."
    },
    {
      "episode": 9,
      "episodeNumber": 9,
      "title": "Suicide or Murder?",
      "aired": "2023-12-03T23:00:00+09:00",
      "airedDate": "2023-12-03T23:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/14/1489603768522f1e9f_w.webp",
      "imageUrl": "https://simkl.in/episodes/14/1489603768522f1e9f_w.webp",
      "description": "An older acquaintance of Jinshi`s dies while drinking at a party. A servant`s body turns up in a moat. Both deaths are written off as self-inflicted, but Maomao`s keen observations tell her that there`s more to both stories."
    },
    {
      "episode": 10,
      "episodeNumber": 10,
      "title": "Honey",
      "aired": "2023-12-10T23:00:00+09:00",
      "airedDate": "2023-12-10T23:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/14/1492536916e53b0f15_w.webp",
      "imageUrl": "https://simkl.in/episodes/14/1492536916e53b0f15_w.webp",
      "description": "A tea party hosted by Lady Gyokuyou puts the politics of the rear palace at the forefront, and Maomao learns something new about Lady Lishu. His true intentions unclear, Jinshi sends Maomao to work for Lady Ah-Duo."
    },
    {
      "episode": 11,
      "episodeNumber": 11,
      "title": "Reducing Two to One",
      "aired": "2023-12-17T23:00:00+09:00",
      "airedDate": "2023-12-17T23:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/14/14961471c695182d64_w.webp",
      "imageUrl": "https://simkl.in/episodes/14/14961471c695182d64_w.webp",
      "description": "Maomao confronts Fengming about the dark secret she`s been hiding from her noble Lady Ah-Duo."
    },
    {
      "episode": 12,
      "episodeNumber": 12,
      "title": "The Eunuch and the Courtesan",
      "aired": "2023-12-24T23:00:00+09:00",
      "airedDate": "2023-12-24T23:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/14/1498875347244b82d7_w.webp",
      "imageUrl": "https://simkl.in/episodes/14/1498875347244b82d7_w.webp",
      "description": "Discovering that Maomao`s kidnappers were connected to Fengming`s family, Jinshi is faced with a choice between keeping Maomao in the rear palace where he can be near her or releasing her from her service."
    },
    {
      "episode": 13,
      "episodeNumber": 13,
      "title": "Serving in the Outer Court",
      "aired": "2024-01-07T23:00:00+09:00",
      "airedDate": "2024-01-07T23:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/15/1510548376691e1e45_w.webp",
      "imageUrl": "https://simkl.in/episodes/15/1510548376691e1e45_w.webp",
      "description": "To Maomao`s surprise, Jinshi brings her directly to his house instead of taking her back to the rear palace, and tells her she`s to work in the outer court. Not only is there much to learn, it seems there`s many eyes on her as the new hire."
    },
    {
      "episode": 14,
      "episodeNumber": 14,
      "title": "The New Pure Consort",
      "aired": "2024-01-14T23:00:00+09:00",
      "airedDate": "2024-01-14T23:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/15/15151627988fc629be_w.webp",
      "imageUrl": "https://simkl.in/episodes/15/15151627988fc629be_w.webp",
      "description": "Ah-Duo`s replacement has arrived in the rear palace, and Maomao is assigned to give a certain lecture to all four high concubines. Later, Maomao helps Lihaku investigate a warehouse explosion."
    },
    {
      "episode": 15,
      "episodeNumber": 15,
      "title": "Raw Fish",
      "aired": "2024-01-21T23:00:00+09:00",
      "airedDate": "2024-01-21T23:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/15/151886511cbbf6ed81_w.webp",
      "imageUrl": "https://simkl.in/episodes/15/151886511cbbf6ed81_w.webp",
      "description": "Gaoshun requests Maomao`s help in solving an apparent poisoning case. Meanwhile, Jinshi deals with an unwelcome visitor who`s taken to lingering in his office."
    },
    {
      "episode": 16,
      "episodeNumber": 16,
      "title": "Lead",
      "aired": "2024-01-28T23:00:00+09:00",
      "airedDate": "2024-01-28T23:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/15/1522018979e3a04180_w.webp",
      "imageUrl": "https://simkl.in/episodes/15/1522018979e3a04180_w.webp",
      "description": "A shack, a chest of drawers, and a fishbowl are all that a talented metalworker leaves to his three sons upon his death. Maomao is assigned to investigate how these strange inheritances all fit together."
    },
    {
      "episode": 17,
      "episodeNumber": 17,
      "title": "A Jaunt Around Town",
      "aired": "2024-02-04T23:00:00+09:00",
      "airedDate": "2024-02-04T23:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/15/152621214f9704928e_w.webp",
      "imageUrl": "https://simkl.in/episodes/15/152621214f9704928e_w.webp",
      "description": "Covering up Jinshi`s otherworldly beauty is no easy task, but after Maomao takes the challenge head-on, she`s surprised when she`s also asked to don the disguise of a noblewoman and escort \"Jinka\" outside the palace."
    },
    {
      "episode": 18,
      "episodeNumber": 18,
      "title": "Lakan",
      "aired": "2024-02-11T23:00:00+09:00",
      "airedDate": "2024-02-11T23:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/15/1529507343156bcbb7_w.webp",
      "imageUrl": "https://simkl.in/episodes/15/1529507343156bcbb7_w.webp",
      "description": "Back at home, Maomao visits an annex building at the Verdigris House that hides one of the brothel`s secrets. Lakan continues to antagonize Jinshi as his connection to Maomao becomes clear."
    },
    {
      "episode": 19,
      "episodeNumber": 19,
      "title": "Chance or Something More",
      "aired": "2024-02-18T23:00:00+09:00",
      "airedDate": "2024-02-18T23:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/15/153259377b46ef4578_w.webp",
      "imageUrl": "https://simkl.in/episodes/15/153259377b46ef4578_w.webp",
      "description": "A discussion with Lihaku about recent events leads Maomao to realize that the mysteries she`s helped to solve are connected. As the final piece of the puzzle falls into place, she rushes to stop impending disaster."
    },
    {
      "episode": 20,
      "episodeNumber": 20,
      "title": "Thornapple",
      "aired": "2024-02-25T23:00:00+09:00",
      "airedDate": "2024-02-25T23:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/15/153646113fd8f71f07_w.webp",
      "imageUrl": "https://simkl.in/episodes/15/153646113fd8f71f07_w.webp",
      "description": "Maomao was able to stop the assassination attempt, but was heavily injured in the process. However, the injuries aren`t enough to stop her curiosity, driving her to confront the culprit behind the incident."
    },
    {
      "episode": 21,
      "episodeNumber": 21,
      "title": "How to Buy Out a Contract",
      "aired": "2024-03-03T23:00:00+09:00",
      "airedDate": "2024-03-03T23:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/15/15397511a5fd73a132_w.webp",
      "imageUrl": "https://simkl.in/episodes/15/15397511a5fd73a132_w.webp",
      "description": "Back to work at the rear palace, Maomao listens to Guen talk about his family`s business. Meanwhile, Lihaku hears a rumor that that whips him into action."
    },
    {
      "episode": 22,
      "episodeNumber": 22,
      "title": "Blue Roses",
      "aired": "2024-03-10T23:00:00+09:00",
      "airedDate": "2024-03-10T23:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/15/15433167021f84a52a_w.webp",
      "imageUrl": "https://simkl.in/episodes/15/15433167021f84a52a_w.webp",
      "description": "Lakan challenges Jinshi to produce blue roses to present at the upcoming garden party, forcing Jinshi to turn once again to Maomao for her help."
    },
    {
      "episode": 23,
      "episodeNumber": 23,
      "title": "Balsam and Woodsorrel",
      "aired": "2024-03-17T23:00:00+09:00",
      "airedDate": "2024-03-17T23:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/15/15473201deb5c453f6_w.webp",
      "imageUrl": "https://simkl.in/episodes/15/15473201deb5c453f6_w.webp",
      "description": "No longer willing to keep running away from Lakan, Maomao decides to face off against him. She challenges him on his own turf, in a chess match."
    },
    {
      "episode": 24,
      "episodeNumber": 24,
      "title": "Jinshi and Maomao",
      "aired": "2024-03-24T23:00:00+09:00",
      "airedDate": "2024-03-24T23:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/15/15506455cfae59f94b_w.webp",
      "imageUrl": "https://simkl.in/episodes/15/15506455cfae59f94b_w.webp",
      "description": "Lakan must now choose a courtesan to buy out. As a high-ranking military official, he can afford to freely choose, even from one of the Three Princesses. Who will he choose? Who does Maomao really want him to choose?"
    }
  ],

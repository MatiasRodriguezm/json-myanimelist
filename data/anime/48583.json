  "episodes_data": [
    {
      "episode": 1,
      "episodeNumber": 1,
      "title": "Judgment",
      "aired": "2022-01-10T00:05:00+09:00",
      "airedDate": "2022-01-10T00:05:00+09:00",
      "thumbnail": "https://simkl.in/episodes/17/174777766efacf3bb4_w.webp",
      "imageUrl": "https://simkl.in/episodes/17/174777766efacf3bb4_w.webp",
      "description": "Caught off guard by Marley`s surprise attack, Eren fends off their Titans alone. As the battle rages on above, the Scouts consider Eren`s motives from the underground dungeons."
    },
    {
      "episode": 2,
      "episodeNumber": 2,
      "title": "Sneak Attack",
      "aired": "2022-01-17T00:05:00+09:00",
      "airedDate": "2022-01-17T00:05:00+09:00",
      "thumbnail": "https://simkl.in/episodes/17/17477778eebbf29f42_w.webp",
      "imageUrl": "https://simkl.in/episodes/17/17477778eebbf29f42_w.webp",
      "description": "The Beast Titan joins the fray, but General Magath is determined to take him down. Meanwhile, with the city in flames, Colt and Gabi rush to rescue Falco who`s held captive by the Jaegerists."
    },
    {
      "episode": 3,
      "episodeNumber": 3,
      "title": "Two Brothers",
      "aired": "2022-01-24T00:05:00+09:00",
      "airedDate": "2022-01-24T00:05:00+09:00",
      "thumbnail": "https://simkl.in/episodes/17/174777800be37e292f_w.webp",
      "imageUrl": "https://simkl.in/episodes/17/174777800be37e292f_w.webp",
      "description": "Colt pleads with Zeke to not use his scream and turn Falco into a Titan. All the while, soldiers and Titans clash in battle as Eren struggles to make contact with his brother."
    },
    {
      "episode": 4,
      "episodeNumber": 4,
      "title": "Memories of the Future",
      "aired": "2022-01-31T00:05:00+09:00",
      "airedDate": "2022-01-31T00:05:00+09:00",
      "thumbnail": "https://simkl.in/episodes/17/17477782ad8dae927a_w.webp",
      "imageUrl": "https://simkl.in/episodes/17/17477782ad8dae927a_w.webp",
      "description": "Zeke takes Eren through Grisha`s memories to show him how he`s been brainwashed. But in doing so, Zeke discovers something about Eren that he never knew."
    },
    {
      "episode": 5,
      "episodeNumber": 5,
      "title": "From You, 2,000 Years Ago",
      "aired": "2022-02-07T00:05:00+09:00",
      "airedDate": "2022-02-07T00:05:00+09:00",
      "thumbnail": "https://simkl.in/episodes/17/17477784bf9779a54c_w.webp",
      "imageUrl": "https://simkl.in/episodes/17/17477784bf9779a54c_w.webp",
      "description": "For 2,000 years, the Founder Ymir has been waiting--a slave to those with royal blood. However, Eren`s yearning for freedom gives her a choice that could shake things up."
    },
    {
      "episode": 6,
      "episodeNumber": 6,
      "title": "Thaw",
      "aired": "2022-02-14T00:05:00+09:00",
      "airedDate": "2022-02-14T00:05:00+09:00",
      "thumbnail": "https://simkl.in/episodes/17/174777864586244a71_w.webp",
      "imageUrl": "https://simkl.in/episodes/17/174777864586244a71_w.webp",
      "description": "With no walls left on the island and Shiganshina full of Titans, the Scouts must battle their former comrades. In the midst of it all, Gabi is determined to find and rescue Falco at whatever cost."
    },
    {
      "episode": 7,
      "episodeNumber": 7,
      "title": "Sunset",
      "aired": "2022-02-21T00:05:00+09:00",
      "airedDate": "2022-02-21T00:05:00+09:00",
      "thumbnail": "https://simkl.in/episodes/17/17477788e940105343_w.webp",
      "imageUrl": "https://simkl.in/episodes/17/17477788e940105343_w.webp",
      "description": "The rumbling is set in motion once all hardening is undone, but this also sets Annie free. As the Jaegerists take control of the island, Conny races towards Ragako to feed Falco to his Titan mother."
    },
    {
      "episode": 8,
      "episodeNumber": 8,
      "title": "Pride",
      "aired": "2022-02-28T00:05:00+09:00",
      "airedDate": "2022-02-28T00:05:00+09:00",
      "thumbnail": "https://simkl.in/episodes/17/17477790a744eab5ed_w.webp",
      "imageUrl": "https://simkl.in/episodes/17/17477790a744eab5ed_w.webp",
      "description": "Upon reaching Ragako, Connie hatches a plan to trick Falco into being eaten by his mother. Elsewhere, hero of the Eldian Empire, Jean, is to execute Yelena and Onyankopon for their crimes against humanity."
    },
    {
      "episode": 9,
      "episodeNumber": 9,
      "title": "Night of the End",
      "aired": "2022-03-07T00:05:00+09:00",
      "airedDate": "2022-03-07T00:05:00+09:00",
      "thumbnail": "https://simkl.in/episodes/17/174777923fefd514b2_w.webp",
      "imageUrl": "https://simkl.in/episodes/17/174777923fefd514b2_w.webp",
      "description": "Deep in the forest, an unlikely rabble of Marley stragglers and island fugitives attempt to set their hatred aside and talk around a campfire without killing each other."
    },
    {
      "episode": 10,
      "episodeNumber": 10,
      "title": "Traitor",
      "aired": "2022-03-14T00:05:00+09:00",
      "airedDate": "2022-03-14T00:05:00+09:00",
      "thumbnail": "https://simkl.in/episodes/17/17477794b178fe1042_w.webp",
      "imageUrl": "https://simkl.in/episodes/17/17477794b178fe1042_w.webp",
      "description": "The Azumabito`s flying boat is guarded by a port full of Jaegerists, but the Scouts are reluctant to kill their former friends. If they wish to avoid bloodshed, they can`t afford their plan to go wrong."
    },
    {
      "episode": 11,
      "episodeNumber": 11,
      "title": "Retrospective",
      "aired": "2022-03-21T00:05:00+09:00",
      "airedDate": "2022-03-21T00:05:00+09:00",
      "thumbnail": "https://simkl.in/episodes/17/174777967593951804_w.webp",
      "imageUrl": "https://simkl.in/episodes/17/174777967593951804_w.webp",
      "description": "For the flying boat to take off, the mechanics need half a day to service it. Knowing they`ll never last that long with Jaegerist reinforcements on the way, the crew is forced to change their plans."
    },
    {
      "episode": 12,
      "episodeNumber": 12,
      "title": "The Dawn of Humanity",
      "aired": "2022-04-04T00:05:00+09:00",
      "airedDate": "2022-04-04T00:05:00+09:00",
      "thumbnail": "https://simkl.in/episodes/17/1747779851220d22a0_w.webp",
      "imageUrl": "https://simkl.in/episodes/17/1747779851220d22a0_w.webp",
      "description": "Regardless of where it all began, Eren commits to his path of destruction during the Scouts` first visit to the Marleyan mainland, leaving Mikasa to wonder if things could`ve been different."
    }

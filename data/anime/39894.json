  "episodes_data": [
    {
      "episode": 1,
      "episodeNumber": 1,
      "title": "New Euphonium",
      "aired": "2024-04-07T17:00:00+09:00",
      "airedDate": "2024-04-07T17:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/17/17543129980382e202_w.webp",
      "imageUrl": "https://simkl.in/episodes/17/17543129980382e202_w.webp",
      "description": "A new year is starting at Kitauji Kyoto Prefectural High School, and that means clubs are clamoring to recruit new members. The concert band welcomes newcomers and sets their goals for the season. Will they choose to fight for gold at Nationals?"
    },
    {
      "episode": 2,
      "episodeNumber": 2,
      "title": "Triangle Syncopation",
      "aired": "2024-04-14T17:00:00+09:00",
      "airedDate": "2024-04-14T17:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/17/175431318651a9f62f_w.webp",
      "imageUrl": "https://simkl.in/episodes/17/175431318651a9f62f_w.webp",
      "description": "Taki decides to let the band executives choose their competition piece this year. The leadership deliberates on this decision while trying to get the rest of the band ready to perform at the Sunrise Festival."
    },
    {
      "episode": 3,
      "episodeNumber": 3,
      "title": "Blue Prelude",
      "aired": "2024-04-21T17:00:00+09:00",
      "airedDate": "2024-04-21T17:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/17/1754313347a4914a11_w.webp",
      "imageUrl": "https://simkl.in/episodes/17/1754313347a4914a11_w.webp",
      "description": "The concert band begins taking itself very seriously to give itself the best chance possible of winning gold at Nationals. Unfortunately, the intense environment has some of the new recruits discouraged and intimidated."
    },
    {
      "episode": 4,
      "episodeNumber": 4,
      "title": "Etude with You",
      "aired": "2024-04-28T17:00:00+09:00",
      "airedDate": "2024-04-28T17:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/17/175431356d900fcdf9_w.webp",
      "imageUrl": "https://simkl.in/episodes/17/175431356d900fcdf9_w.webp",
      "description": "The day of the Sunrise Festival finally arrives, and it`s time for the concert band to have their first performance of the year. Proximity to other schools and bands brings some of Motomu`s family issues to light."
    },
    {
      "episode": 5,
      "episodeNumber": 5,
      "title": "Twilight for Two",
      "aired": "2024-05-05T17:00:00+09:00",
      "airedDate": "2024-05-05T17:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/17/175431372f3d0a8d41_w.webp",
      "imageUrl": "https://simkl.in/episodes/17/175431372f3d0a8d41_w.webp",
      "description": "Now that she`s well into her third-year, Kumiko is now facing pressure from teachers and parents alike to choose what she`s doing after high school. Concert band members form groups to attend the Agata Festival, but Kumiko has other plans."
    },
    {
      "episode": 6,
      "episodeNumber": 6,
      "title": "Wavering Dissonance",
      "aired": "2024-05-12T17:00:00+09:00",
      "airedDate": "2024-05-12T17:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/17/17543139e162435722_w.webp",
      "imageUrl": "https://simkl.in/episodes/17/17543139e162435722_w.webp",
      "description": "The Prefecturals are coming up and that means the first of many auditions for the members of the concert band. Mayu is still hesitant to audition despite reassurance from the others. Some of Taki`s choices for the competition confuse members."
    },
    {
      "episode": 7,
      "episodeNumber": 7,
      "title": "Summer Fermata",
      "aired": "2024-05-19T17:00:00+09:00",
      "airedDate": "2024-05-19T17:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/17/175431418820037f12_w.webp",
      "imageUrl": "https://simkl.in/episodes/17/175431418820037f12_w.webp",
      "description": "Members of the concert band are given a brief, three-day summer break that quickly fills with plans of all sorts. Some of the third-years attend an event to gather information on different colleges and plan their futures."
    },
    {
      "episode": 8,
      "episodeNumber": 8,
      "title": "Melancholy Ostinato",
      "aired": "2024-05-26T17:00:00+09:00",
      "airedDate": "2024-05-26T17:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/17/17543143bb932a62d8_w.webp",
      "imageUrl": "https://simkl.in/episodes/17/17543143bb932a62d8_w.webp",
      "description": "The three-day summer camp has begun, and members of the concert band are faced with a rigorous training regimen. Mayu hesitates to audition yet again, afraid that she`ll take the soli part from Kumiko. Motomu speaks to Midori in private."
    },
    {
      "episode": 9,
      "episodeNumber": 9,
      "title": "Dissonant Tuning",
      "aired": "2024-06-02T17:00:00+09:00",
      "airedDate": "2024-06-02T17:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/17/17543145ed831a4ef1_w.webp",
      "imageUrl": "https://simkl.in/episodes/17/17543145ed831a4ef1_w.webp",
      "description": "Mayu taking the soli part has made the concert band uneasy. Despite Kumiko`s insistence that this is how it should be, several members take issue with Taki`s decision."
    },
    {
      "episode": 10,
      "episodeNumber": 10,
      "title": "Expressing Arpeggios",
      "aired": "2024-06-09T17:00:00+09:00",
      "airedDate": "2024-06-09T17:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/17/17543147700872ddb5_w.webp",
      "imageUrl": "https://simkl.in/episodes/17/17543147700872ddb5_w.webp",
      "description": "The Kansai competition is right around the corner, and the band`s dissent about Taki-sensei`s decisions only continues to grow. Kumiko goes to speak with him, and she has to decide whether to speak her mind."
    },
    {
      "episode": 11,
      "episodeNumber": 11,
      "title": "Orchestra to the Future",
      "aired": "2024-06-16T17:00:00+09:00",
      "airedDate": "2024-06-16T17:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/17/175431495db183ea56_w.webp",
      "imageUrl": "https://simkl.in/episodes/17/175431495db183ea56_w.webp",
      "description": "The concert band receives its Kansai competition results. Reina and Kumiko see Yoroizuka perform with some of their senpais. However, Kumiko and Reina`s relationship becomes precarious as she continues to insist she won`t go to music school."
    },
    {
      "episode": 12,
      "episodeNumber": 12,
      "title": "The Last Soloist",
      "aired": "2024-06-23T17:00:00+09:00",
      "airedDate": "2024-06-23T17:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/17/1754315137f43aa231_w.webp",
      "imageUrl": "https://simkl.in/episodes/17/1754315137f43aa231_w.webp",
      "description": "Taki decides that the band will choose the euphonium soli player by voting on one final audition. Kumiko then decides that they should choose based on sound alone, and so the two of them audition anonymously."
    },
    {
      "episode": 13,
      "episodeNumber": 13,
      "title": "Connecting Melodies",
      "aired": "2024-06-30T17:00:00+09:00",
      "airedDate": "2024-06-30T17:00:00+09:00",
      "thumbnail": "https://simkl.in/episodes/17/17543153edb67f5fb4_w.webp",
      "imageUrl": "https://simkl.in/episodes/17/17543153edb67f5fb4_w.webp",
      "description": "The final competition for the third-years is at hand. The Kitauji High School Concert Band performs together one last time in a bid for National gold."
    }
  ],

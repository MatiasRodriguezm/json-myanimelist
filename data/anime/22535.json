      "thumbnail": "https://simkl.in/episodes/62/62952886d15a923bb_w.webp",
      "imageUrl": "https://simkl.in/episodes/62/62952886d15a923bb_w.webp",
      "description": "With no chance to survive, Shinichi pulls off a desperate move."
    },
    {
      "episode": 24,
      "episodeNumber": 24,
      "title": "Parasyte",
      "aired": "2015-03-26T01:29:00+09:00",
      "airedDate": "2015-03-26T01:29:00+09:00",
      "thumbnail": "https://simkl.in/episodes/62/629527895cb867797_w.webp",

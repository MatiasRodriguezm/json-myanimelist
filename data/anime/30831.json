  "episodes_data": [
    {
      "episode": 1,
      "episodeNumber": 1,
      "title": "This Self-Proclaimed Goddess and Reincarnation in Another World!",
      "aired": "2016-01-14T01:05:00+09:00",
      "airedDate": "2016-01-14T01:05:00+09:00",
      "thumbnail": "https://simkl.in/episodes/76/7669145f7b8ae1ea2_w.webp",
      "imageUrl": "https://simkl.in/episodes/76/7669145f7b8ae1ea2_w.webp",
      "description": "Gamer Kazuma dies in a freak accident, and is met in the afterlife by a crass goddess, Aqua."
    },
    {
      "episode": 2,
      "episodeNumber": 2,
      "title": "An Explosion for This Chunibyo!",
      "aired": "2016-01-21T01:05:00+09:00",
      "airedDate": "2016-01-21T01:05:00+09:00",
      "thumbnail": "https://simkl.in/episodes/76/7669143d134518667_w.webp",
      "imageUrl": "https://simkl.in/episodes/76/7669143d134518667_w.webp",
      "description": "It`s great for Kazuma that he brought Aqua along with him, but unlike in a game world, much is missing from his adventurer`s lifestyle. No money, no equipment, and even fighting the lowest ranking monsters is a hard-fought battle. That`s when they decide to recruit new party members."
    },
    {
      "episode": 3,
      "episodeNumber": 3,
      "title": "A Panty Treasure in This Right Hand!",
      "aired": "2016-01-28T01:05:00+09:00",
      "airedDate": "2016-01-28T01:05:00+09:00",
      "thumbnail": "https://simkl.in/episodes/76/76691413647b539a4_w.webp",
      "imageUrl": "https://simkl.in/episodes/76/76691413647b539a4_w.webp",
      "description": "A low-grade goddess turned arch priest who works hard to acquire party trick skills, a dissapointing arch wizard who can only unleash explosion magic once per day, and Kazuma himself, whose only redeeming quality is his good luck. Kazuma despairs over the completely useless party that`s been formed."
    },
    {
      "episode": 4,
      "episodeNumber": 4,
      "title": "Explosion Magic for This Formidable Enemy!",
      "aired": "2016-02-04T01:05:00+09:00",
      "airedDate": "2016-02-04T01:05:00+09:00",
      "thumbnail": "https://simkl.in/episodes/76/7669139f123995828_w.webp",
      "imageUrl": "https://simkl.in/episodes/76/7669139f123995828_w.webp",
      "description": "All of the weak monsters have gone into hiding since a leader of the devil king`s army has settled in near town. Kazuma, who had been focusing on improving his skills, is stuck at a standstill. With nothing else to do, Kazuma tags along with Megumin`s training, which consists of unleashing explosion magic into an abandoned castle."
    },
    {
      "episode": 5,
      "episodeNumber": 5,
      "title": "A Price for This Cursed Sword!",
      "aired": "2016-02-11T01:05:00+09:00",
      "airedDate": "2016-02-11T01:05:00+09:00",
      "thumbnail": "https://simkl.in/episodes/76/76691379176093f5a_w.webp",
      "imageUrl": "https://simkl.in/episodes/76/76691379176093f5a_w.webp",
      "description": "With debt looming over her, Aqua convinces Kazuma to accept a high difficulty quest to purify a lake, which doesn`t require killing any monsters."
    },
    {
      "episode": 6,
      "episodeNumber": 6,
      "title": "A Conclusion to This Worthless Fight!",
      "aired": "2016-02-18T01:05:00+09:00",
      "airedDate": "2016-02-18T01:05:00+09:00",
      "thumbnail": "https://simkl.in/episodes/76/7669135b6983f45cf_w.webp",
      "imageUrl": "https://simkl.in/episodes/76/7669135b6983f45cf_w.webp",
      "description": "Dullahan, a top leader in the Devil King`s army, yet again appears at the city in a frenzied rage."
    },
    {
      "episode": 7,
      "episodeNumber": 7,
      "title": "A Second Death in This Freezing Season!",
      "aired": "2016-02-25T01:05:00+09:00",
      "airedDate": "2016-02-25T01:05:00+09:00",
      "thumbnail": "https://simkl.in/episodes/76/7669133139e482cf8_w.webp",
      "imageUrl": "https://simkl.in/episodes/76/7669133139e482cf8_w.webp",
      "description": "\"I want money.\" After paying back the debt Aqua has racked up, Kazuma and Aqua`s monetary situation grows even more dire. The party accepts a quest to kill helpless Snow Sprites and heads for the snowy mountains in order to escape from the stables during this winter so cold it freezes Kazuma`s eyelashes solid."
    },
    {
      "episode": 8,
      "episodeNumber": 8,
      "title": "A Loving Hand for Our Party When We Can't Make It Through Winter!",
      "aired": "2016-03-03T01:05:00+09:00",
      "airedDate": "2016-03-03T01:05:00+09:00",
      "thumbnail": "https://simkl.in/episodes/76/7669131f2dbb13ac9_w.webp",
      "imageUrl": "https://simkl.in/episodes/76/7669131f2dbb13ac9_w.webp",
      "description": "Kazuma and Aqua can`t properly accept rewards from quests due to their mediocre party lineup, and are so destitute that even keeping wood on the fire is difficult. Kazuma comes up with a plan and visits a magical accessories shop run by a woman called Wiz."
    },
    {
      "episode": 9,
      "episodeNumber": 9,
      "title": "God's Blessing on This Wonderful Shop!",
      "aired": "2016-03-10T01:05:00+09:00",
      "airedDate": "2016-03-10T01:05:00+09:00",
      "thumbnail": "https://simkl.in/episodes/76/7669129a121999646_w.webp",
      "imageUrl": "https://simkl.in/episodes/76/7669129a121999646_w.webp",
      "description": "Kazuma runs into some adventurers he knows while out for a walk and decides to go with them to a shop run by succubi said to show its customers enticing dreams."
    },
    {
      "episode": 10,
      "episodeNumber": 10,
      "title": "Final Flame for This Over-the-Top Fortress!",
      "aired": "2016-03-17T01:05:00+09:00",
      "airedDate": "2016-03-17T01:05:00+09:00",
      "thumbnail": "https://simkl.in/episodes/76/766912739baa4ce94_w.webp",
      "imageUrl": "https://simkl.in/episodes/76/766912739baa4ce94_w.webp",
      "description": "The rampaging ancient weapon: the mobile fortress, Destroyer, is headed straight for Kazuma and party`s city!"
    }
